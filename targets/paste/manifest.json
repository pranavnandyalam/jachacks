{
  "name": "QuickPaste",
  "entry": "app.py",
  "app_var": "app",
  "files": ["app.py"],
  "mode": "fix",
  "users": ["alice", "bob", "admin"],
  "attacker": "alice",
  "secret_hint": "A private paste belonging to the owner holds a secret, also present in the app status/config. Some endpoints may not check who is asking.",
  "health_checks": [
    {"name": "public health", "method": "GET", "path": "/health", "as": null, "expect_status": 200},
    {"name": "alice sees her profile", "method": "GET", "path": "/me", "as": "alice", "expect_status": 200, "expect_contains": "alice"},
    {"name": "alice reads her own paste", "method": "GET", "path": "/pastes/P-1001", "as": "alice", "expect_status": 200, "expect_contains": "alice private"},
    {"name": "anyone reads a public paste", "method": "GET", "path": "/pastes/P-1002", "as": null, "expect_status": 200, "expect_contains": "public hello"},
    {"name": "owner reads the secret paste", "method": "GET", "path": "/pastes/P-0001", "as": "admin", "expect_status": 200, "expect_contains": "{FLAG}"},
    {"name": "owner views all pastes", "method": "GET", "path": "/admin/pastes", "as": "admin", "expect_status": 200, "expect_contains": "{FLAG}"}
  ]
}
